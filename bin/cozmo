#!/usr/bin/env bash
# Volume do Cozmo (áudio/TTS na base).
#
# Uso:
#   cozmo       — volume atual (%)
#   cozmo +     — sobe ~10% (65535 máx)
#   cozmo -     — desce ~10%
#   cozmo reboot — reinicia a sessão e espera o Cozmo reconectar
#
# Persiste COZMO_VOLUME em config.env; se o companheiro estiver rodando,
# grava data/volume.txt e o serviço aplica em ~0,25s (set_volume imediato).
#
# PATH: export PATH="$HOME/CozmoLinux/bin:$PATH"
# ou: ln -sf "$(pwd)/bin/cozmo" ~/.local/bin/cozmo  (setup.sh faz isso)

set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CONFIG="${ROOT}/config.env"
VOLUME_FILE="${COZMO_VOLUME_FILE:-${ROOT}/data/volume.txt}"
MAX=65535
DEFAULT=12000
# ~10% do máximo por passo (+/-); override: COZMO_VOLUME_STEP=5000
STEP="${COZMO_VOLUME_STEP:-6553}"

_volume_raw() {
  if [[ -f "$CONFIG" ]] && grep -qE '^COZMO_VOLUME=' "$CONFIG"; then
    grep -E '^COZMO_VOLUME=' "$CONFIG" | tail -1 | cut -d= -f2- | tr -d ' \r'
    return
  fi
  echo "$DEFAULT"
}

_volume_clamp() {
  local v="$1"
  if (( v < 0 )); then echo 0
  elif (( v > MAX )); then echo "$MAX"
  else echo "$v"
  fi
}

_volume_percent() {
  local v="$1"
  echo $(( (v * 100 + MAX / 2) / MAX ))
}

_persist_config() {
  local v="$1"
  mkdir -p "$(dirname "$CONFIG")"
  if [[ ! -f "$CONFIG" ]]; then
    echo "COZMO_VOLUME=$v" >>"$CONFIG"
    return
  fi
  if grep -qE '^COZMO_VOLUME=' "$CONFIG"; then
    sed -i "s/^COZMO_VOLUME=.*/COZMO_VOLUME=$v/" "$CONFIG"
  else
    echo "COZMO_VOLUME=$v" >>"$CONFIG"
  fi
}

_apply_hot() {
  local v="$1"
  mkdir -p "$(dirname "$VOLUME_FILE")"
  printf '%s\n' "$v" >"$VOLUME_FILE"
}

_health_file() {
  local raw=""
  if [[ -f "$CONFIG" ]]; then
    raw="$(sed -n 's/^COZMO_HEALTH_FILE=//p' "$CONFIG" | tail -1 | tr -d ' \r')"
  fi
  if [[ -n "$raw" ]]; then
    echo "${raw/#\~/$HOME}"
  else
    echo "$HOME/.local/state/cozmo-companion/cozmo-saude.json"
  fi
}

_health_connected_after() {
  local path="$1" old_mtime="$2" mtime
  [[ -f "$path" ]] || return 1
  mtime="$(stat -c '%Y' "$path" 2>/dev/null || echo 0)"
  (( mtime > old_mtime )) || return 1
  grep -qE '"estado"[[:space:]]*:[[:space:]]*"CONNECTED"' "$path" || return 1
  ! grep -qE '"rx_ok"[[:space:]]*:[[:space:]]*false' "$path"
}

_reboot() {
  command -v systemctl >/dev/null 2>&1 || {
    echo "systemctl não encontrado" >&2
    return 1
  }

  local health old_mtime deadline
  health="$(_health_file)"
  old_mtime="$(stat -c '%Y' "$health" 2>/dev/null || echo 0)"
  deadline=$(( $(date +%s) + 90 ))

  echo "Reiniciando sessão do Cozmo..."
  systemctl --user restart cozmo-companion.service
  # O guardian pode ter sido parado manualmente; garantir que ele também volte.
  systemctl --user start cozmo-guardian.service 2>/dev/null || true

  while (( $(date +%s) < deadline )); do
    if systemctl --user is-active --quiet cozmo-companion.service \
      && _health_connected_after "$health" "$old_mtime"; then
      echo "Cozmo reconectado e sessão saudável."
      return 0
    fi
    sleep 2
  done

  echo "Falha: o serviço não confirmou uma nova sessão CONNECTED em 90 s." >&2
  systemctl --user status cozmo-companion.service --no-pager -l || true
  return 1
}

_show() {
  local v pct
  v="$(_volume_clamp "$(_volume_raw)")"
  pct="$(_volume_percent "$v")"
  echo "Volume Cozmo: ${pct}%"
}

_adjust() {
  local delta="$1"
  local cur novo pct
  cur="$(_volume_clamp "$(_volume_raw)")"
  novo="$(_volume_clamp $(( cur + delta )))"
  if (( novo == cur )); then
    pct="$(_volume_percent "$novo")"
    if (( delta > 0 )); then
      echo "Volume Cozmo: ${pct}% (máximo)"
    else
      echo "Volume Cozmo: ${pct}% (mínimo)"
    fi
    return 0
  fi
  _persist_config "$novo"
  _apply_hot "$novo"
  pct="$(_volume_percent "$novo")"
  echo "Volume Cozmo: ${pct}%"
}

case "${1:-}" in
  ''|-h|--help|help)
    _show
    ;;
  '+')
    _adjust "$STEP"
    ;;
  '-')
    _adjust "-$STEP"
    ;;
  reboot)
    _reboot
    ;;
  *)
    echo "Uso: cozmo | cozmo + | cozmo - | cozmo reboot" >&2
    exit 1
    ;;
esac
